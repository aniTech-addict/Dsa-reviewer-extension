{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "none",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "package-lock.json",
    "*.md"
  ]
}
