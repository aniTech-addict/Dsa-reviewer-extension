{
  "name": "DSA Analyzer",
  "description": "version",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "images/icons/icon1.png"
  },
  "icons": {
    "320": "images/icons/icon1.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://leetcode.com/problems/*/submissions/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],

  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": ["https://leetcode.com/problems/*"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/icons/icon1.png",
        "images/icons/DSA_action_icon.png"
      ],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "background": {
    "service_worker": "workers/getAnalysisResponse.js",
    "type": "module"
  }
}
