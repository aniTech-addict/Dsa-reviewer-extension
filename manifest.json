{
  "name": "Hello World",
  "description": "version",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "images/analyzer.png"
  },
  "icons": {
    "48": "images/analyzer.png",
    "320": "images/analyzer.png"
  },
  "permissions": [ 
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*/submissions/*",
    "https://generativelanguage.googleapis.com/*"
  ],

  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": ["https://leetcode.com/problems/*"],
      "run_at": "document_idle"
    }

  ],
  "web_accessible_resources": [
    {
      "resources": ["images/analyzer.png", "scripts/pageBridge.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "background": {
    "service_worker": "workers/getAnalysisResponse.js"
  }
}
